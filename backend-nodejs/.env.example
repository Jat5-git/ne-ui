# ---- Neon ----
# Serverless HTTPS driver (works everywhere: Node, Edge, Vercel, Cloudflare)
DATABASE_URL=postgres://user:pass@ep-xxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# Pooled TCP driver for long-lived worker processes (recommended for background jobs)
DATABASE_POOL_URL=postgres://user:pass@ep-xxxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# ---- App ----
PORT=8080
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,https://app.yourdomain.com

# ---- Auth ----
JWT_SECRET=change-me-in-prod-use-a-64-char-random-string
JWT_EXPIRES_IN=7d

# ---- S3 / object storage (any S3-compatible works: AWS S3, R2, Wasabi, MinIO) ----
S3_BUCKET=one-to-many-uploads
S3_REGION=us-east-1
S3_ENDPOINT=                       # leave empty for AWS; set for R2/MinIO
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CDN_BASE_URL=https://cdn.yourdomain.com
